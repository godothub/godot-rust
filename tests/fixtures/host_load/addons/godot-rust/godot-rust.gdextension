[configuration]

entry_symbol = "godot_rust_init"
compatibility_minimum = "4.4"
reloadable = true

[libraries]

macos.debug = "res://addons/godot-rust/bin/macos-universal/libgodot_rs_host.dylib"
macos.release = "res://addons/godot-rust/bin/macos-universal/libgodot_rs_host.dylib"
linux.debug.x86_64 = "res://addons/godot-rust/bin/linux-x86_64/libgodot_rs_host.so"
linux.release.x86_64 = "res://addons/godot-rust/bin/linux-x86_64/libgodot_rs_host.so"
linux.debug.arm64 = "res://addons/godot-rust/bin/linux-arm64/libgodot_rs_host.so"
linux.release.arm64 = "res://addons/godot-rust/bin/linux-arm64/libgodot_rs_host.so"
linux.debug.arm32 = "res://addons/godot-rust/bin/linux-arm32/libgodot_rs_host.so"
linux.release.arm32 = "res://addons/godot-rust/bin/linux-arm32/libgodot_rs_host.so"
linux.debug.x86_32 = "res://addons/godot-rust/bin/linux-x86_32/libgodot_rs_host.so"
linux.release.x86_32 = "res://addons/godot-rust/bin/linux-x86_32/libgodot_rs_host.so"
windows.debug.x86_64 = "res://addons/godot-rust/bin/windows-x86_64/godot_rs_host.dll"
windows.release.x86_64 = "res://addons/godot-rust/bin/windows-x86_64/godot_rs_host.dll"
windows.debug.x86_32 = "res://addons/godot-rust/bin/windows-x86_32/godot_rs_host.dll"
windows.release.x86_32 = "res://addons/godot-rust/bin/windows-x86_32/godot_rs_host.dll"
windows.debug.arm64 = "res://addons/godot-rust/bin/windows-arm64/godot_rs_host.dll"
windows.release.arm64 = "res://addons/godot-rust/bin/windows-arm64/godot_rs_host.dll"
android.debug.arm32 = "res://addons/godot-rust/bin/android-arm32/libgodot_rs_host.so"
android.release.arm32 = "res://addons/godot-rust/bin/android-arm32/libgodot_rs_host.so"
android.debug.arm64 = "res://addons/godot-rust/bin/android-arm64/libgodot_rs_host.so"
android.release.arm64 = "res://addons/godot-rust/bin/android-arm64/libgodot_rs_host.so"
android.debug.x86_32 = "res://addons/godot-rust/bin/android-x86_32/libgodot_rs_host.so"
android.release.x86_32 = "res://addons/godot-rust/bin/android-x86_32/libgodot_rs_host.so"
android.debug.x86_64 = "res://addons/godot-rust/bin/android-x86_64/libgodot_rs_host.so"
android.release.x86_64 = "res://addons/godot-rust/bin/android-x86_64/libgodot_rs_host.so"
ios.debug = "res://addons/godot-rust/bin/apple/godot_rs_host.xcframework"
ios.release = "res://addons/godot-rust/bin/apple/godot_rs_host.xcframework"
web.debug.wasm32 = "res://.godot/rust/web-host/godot_rs_host.wasm"
web.release.wasm32 = "res://.godot/rust/web-host/godot_rs_host.wasm"
