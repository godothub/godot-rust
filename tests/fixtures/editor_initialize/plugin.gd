@tool
extends EditorPlugin

const MANIFEST_PATH := "res://Cargo.toml"
const CRATE_ROOT_PATH := "res://src/lib.rs"
const INDEX_PATH := "res://src/scripts/mod.rs"
const CARGO_CONFIG_PATH := "res://.cargo/config.toml"


func _enter_tree() -> void:
	call_deferred("_verify_automatic_initialization")


func _verify_automatic_initialization() -> void:
	for _frame in 5:
		await get_tree().process_frame
	var godot_rust_plugin := get_tree().get_first_node_in_group(
		&"godot_rust_editor_plugin"
	)
	if godot_rust_plugin == null:
		_fail("The godot-rust editor plugin is absent from the editor tree")
		return

	var deadline := Time.get_ticks_msec() + 30_000
	while not godot_rust_plugin.is_workflow_configured() and Time.get_ticks_msec() < deadline:
		if _has_visible_initialization_confirmation(
			get_editor_interface().get_base_control()
		):
			_fail("Automatic Cargo initialization displayed a confirmation dialog")
			return
		await get_tree().process_frame

	if not godot_rust_plugin.is_workflow_configured() or not godot_rust_plugin.is_auto_check_enabled():
		_fail("Automatic Cargo initialization did not configure the Rust editor workflow")
		return
	if not FileAccess.file_exists(MANIFEST_PATH):
		_fail("godot-rust did not initialize Cargo automatically")
		return
	var manifest := _read_text(MANIFEST_PATH)
	if (
		'name = "godothub_project"' not in manifest
		or 'godot_rs = "0.9"' not in manifest
		or 'crate-type = ["cdylib", "rlib"]' not in manifest
		or "[package.metadata.godot-rust]" not in manifest
	):
		_fail("Automatic Cargo initialization produced an incomplete manifest")
		return
	if "mod scripts;" not in _read_text(CRATE_ROOT_PATH):
		_fail("Automatic Cargo initialization did not create the script entry")
		return
	if "@generated by godot-rust" not in _read_text(INDEX_PATH):
		_fail("Automatic Cargo initialization did not generate the script index")
		return
	if 'target-dir = ".godot/rust/target"' not in _read_text(CARGO_CONFIG_PATH):
		_fail("Automatic Cargo initialization did not isolate Cargo output")
		return

	print("GODOT_RUST_INITIALIZATION_AUTOMATIC")
	print("GODOT_RUST_INITIALIZATION_CONFIGURED")
	get_tree().quit()


func _has_visible_initialization_confirmation(node: Node) -> bool:
	if node is ConfirmationDialog and node.visible:
		var title := str(node.title)
		var dialog_text := str(node.dialog_text)
		if (
			"Initialize Rust" in title
			or "初始化 Rust" in title
			or "cargo init" in dialog_text
		):
			return true
	for child in node.get_children():
		if (
			child is Node
			and _has_visible_initialization_confirmation(child)
		):
			return true
	return false


func _read_text(path: String) -> String:
	var file := FileAccess.open(path, FileAccess.READ)
	if file == null:
		return ""
	return file.get_as_text()


func _fail(message: String) -> void:
	push_error("godot-rust editor initialization test: %s" % message)
	get_tree().quit(1)
